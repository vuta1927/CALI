{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Cali": ""
  },
  "Auth": {
    "Audience": "cali-api"
  },
  "Migrations": {
    "ScriptsPath": "",
    "ApplyOnStartup": false,
    "JournalTable": "schema_versions"
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Sync": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Ai": { "PermitLimit": 5, "WindowSeconds": 60 }
  },
  "Telemetry": {
    "Exporter": "none"
  }
}
