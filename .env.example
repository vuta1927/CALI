# Copy to .env (git-ignored) and fill in. Never commit real secrets.
# Used by docker-compose.yml.

POSTGRES_DB=cali
POSTGRES_USER=cali
# Required. Pick any local-only password.
POSTGRES_PASSWORD=

# Host ports (bound to 127.0.0.1 only).
CALI_DB_HOST_PORT=55432
CALI_API_HOST_PORT=8080

# Optional, Development only: base64 key (>= 32 bytes) for dev JWTs.
# Generate with: dotnet run --project backend/tools/Cali.DevToken -- new-key
# Leave empty to disable dev tokens (every authenticated call then returns 401).
CALI_DEV_TOKEN_SIGNING_KEY=

# Optional, Development only: the app bundle id (the `aud` of Sign in with Apple identity tokens).
# Leave empty and POST /v1/auth/apple answers 503. Not a secret. Outside Development this is required
# (Auth__Apple__ClientId) together with the secret Auth__AccessTokenSigningKey.
CALI_APPLE_CLIENT_ID=

# none | console | otlp (otlp honours the standard OTEL_EXPORTER_OTLP_* variables)
CALI_TELEMETRY_EXPORTER=none
